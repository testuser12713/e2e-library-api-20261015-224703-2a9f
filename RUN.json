{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "python",
      "kind": "server",
      "install": [["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]],
      "start": ["${python}", "-m", "uvicorn", "app.main:app", "--port", "${PORT}"],
      "port": 8000,
      "port_env": "PORT",
      "health": {"path": "/health", "expect_status": [200]},
      "env": {
        "LIBRARY_API_KEY": {"generate": "urlsafe"},
        "DATABASE_URL": {"dev": "sqlite:///./library.db"}
      },
      "test": [["${python}", "-m", "pytest", "-q"]]
    }
  ]
}
